              "children": [
                {
                  "type": "frame",
                  "id": "D4zrIR",
                  "name": "Card - Toolbar",
                  "width": 580,
                  "fill": "$color.surface",
                  "cornerRadius": "$radius.md",
                  "layout": "vertical",
                  "gap": 8,
                  "padding": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "ylasz",
                      "name": "Title",
                      "fill": "$color.text.primary",
                      "content": "Toolbar Primitive Mapping (@radix-ui/react-toolbar)",
                      "fontFamily": "$font.sans",
                      "fontSize": "$font.size.label",
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "HRGcr",
                      "name": "Content",
                      "fill": "$color.text.secondary",
                      "content": "• Toolbar.Root: Container frame with role='toolbar' and orientation='horizontal' | 'vertical'\n• Toolbar.ToggleGroup: Flex group of formatting toggles (type='single' | 'multiple')\n• Toolbar.ToggleItem: High-contrast state button (active fill vs transparent)\n• Toolbar.Separator: 1px divider between formatting, actions, and settings\n• Toolbar.Button: Direct action pill button (e.g. 'Ask Scribe', 'Polish')",
                      "fontFamily": "$font.sans",
                      "fontSize": "$font.size.caption"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "N7vtyh",
                  "name": "Card - Popover",
                  "width": 580,
                  "fill": "$color.surface",
                  "cornerRadius": "$radius.md",
                  "layout": "vertical",
                  "gap": 8,
                  "padding": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "bAyqq",
                      "name": "Title",
                      "fill": "$color.text.primary",
                      "content": "Popover Primitive Mapping (@radix-ui/react-popover)",
                      "fontFamily": "$font.sans",
                      "fontSize": "$font.size.label",
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "g2LAX3",
                      "name": "Content",
                      "fill": "$color.text.secondary",
                      "content": "• Popover.Root: Manages open/close state anchoring to text selection or cursor\n• Popover.Trigger: Hidden virtual anchor or inline text range reference\n• Popover.Content: Elevated floating card with shadow-2xl, radius-md, and esc handler\n• Popover.Item / Action: Keyboard-focusable menu item with icon and shortcut badge\n• Popover.Close: Dismiss action triggering immediate closing transition",
                      "fontFamily": "$font.sans",
                      "fontSize": "$font.size.caption"
                    }
                  ]
                }
              ]
            }
          ]
        },
