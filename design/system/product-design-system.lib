                  "name": "Card - Agent Chat Spec",
                  "width": 580,
                  "fill": "$color.surface",
                  "cornerRadius": "$radius.md",
                  "layout": "vertical",
                  "gap": 8,
                  "padding": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "sjemD",
                      "name": "Title",
                      "fill": "$color.text.primary",
                      "content": "Agent Chat Architecture (Design #1)",
                      "fontFamily": "$font.sans",
                      "fontSize": "$font.size.label",
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "jGV6K",
                      "name": "Content",
                      "fill": "$color.text.secondary",
                      "content": "• Root: Rounded-2xl container with elevation shadow and inner flex layout\n• Textarea: Auto-expanding textarea without native border/outline\n• Select.Root: Radix Select managing chosen AI model state (value, onValueChange)\n• Select.Trigger: Pill badge containing model name, quality tag, and chevron\n• Actions: Circular attachment trigger and primary Send action (↵ to submit, ⇧↵ for newline)",
                      "fontFamily": "$font.sans",
                      "fontSize": "$font.size.caption"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "y7lxh",
                  "name": "Card - Inline Floating Spec",
                  "width": 580,
                  "fill": "$color.surface",
                  "cornerRadius": "$radius.md",
                  "layout": "vertical",
                  "gap": 8,
                  "padding": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "n0GJL",
                      "name": "Title",
                      "fill": "$color.text.primary",
                      "content": "Inline Floating Architecture (Designs #2 & #3)",
                      "fontFamily": "$font.sans",
                      "fontSize": "$font.size.label",
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "NfivW",
                      "name": "Content",
                      "fill": "$color.text.secondary",
                      "content": "• Root: Rounded-full pill container floating above/below selection on the canvas\n• Lead Icon: Lucide sparkles indicating AI instruction mode\n• Input: Single-line transparent input field with instant character response\n• Compact Select: Embedded micro-trigger for on-the-fly model switching (Design #3)\n• Submit: Circular 34x34 primary pill button executing immediate canvas transformation",
                      "fontFamily": "$font.sans",
                      "fontSize": "$font.size.caption"
                    }
                  ]
                }
              ]
            }
          ]
        }
